<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Ultron - Launcher</title>
<HTA:APPLICATION ID="Ultron" APPLICATIONNAME="Ultron Launcher" BORDER="thin" CAPTION="yes" SHOWINTASKBAR="yes" SINGLEINSTANCE="yes" SYSMENU="yes" WINDOWSTATE="normal" SCROLL="no" />
<style>
body { font-family: Consolas, monospace; background: #000; color: #ffaa30; margin: 0; padding: 24px; }
.card { max-width: 560px; margin: 0 auto; background: #0a0500; border: 1px solid #ffaa30; border-radius: 8px; padding: 24px; }
h1 { font-size: 22px; margin: 0 0 6px 0; letter-spacing: 4px; }
p { font-size: 12px; color: #cc8830; }
button { display: block; width: 100%; margin: 8px 0; padding: 12px; font-size: 13px; font-weight: bold; font-family: Consolas, monospace; letter-spacing: 1px; color: #ffaa30; background: #140a00; border: 1px solid #ffaa30; border-radius: 4px; cursor: pointer; }
button.main { background: #783c00; color: #ffcc66; }
button:hover { background: #3c1e00; }
.small { font-size: 11px; color: #885500; margin-top: 12px; }
</style>
<script language="VBScript">
Function HtaDir()
  Dim path
  path = Mid(document.location.href, 9)
  path = Replace(path, "/", "\")
  path = Unescape(path)
  HtaDir = Left(path, InStrRev(path, "\"))
End Function

Sub StartDev()
  Dim sh
  Set sh = CreateObject("WScript.Shell")
  sh.Run "cmd /k " & Chr(34) & "cd /d " & Chr(34) & HtaDir() & Chr(34) & " && npm install && npm run dev" & Chr(34), 1, False
  Set sh = Nothing
End Sub

Sub OpenSite()
  Dim sh
  Set sh = CreateObject("WScript.Shell")
  sh.Run Chr(34) & "http://localhost:3000" & Chr(34), 1, False
  Set sh = Nothing
End Sub

Sub OpenFolder()
  Dim sh
  Set sh = CreateObject("WScript.Shell")
  sh.Run Chr(34) & "explorer.exe" & Chr(34) & " " & Chr(34) & HtaDir() & Chr(34), 1, False
  Set sh = Nothing
End Sub
</script>
</head>
<body>
<div class="card">
<h1>U.L.T.R.O.N.</h1>
<p>Iron Man-inspired holographic orb (Next.js + Three.js + MediaPipe hand tracking). This is a Node app - it needs a dev server, there is no plain .html entry.</p>
<button class="main" onclick="StartDev">1) Start Server (npm install + npm run dev)</button>
<button onclick="OpenSite">2) Open http://localhost:3000</button>
<button onclick="OpenFolder">Open Project Folder</button>
<p class="small">Steps: click 1, wait for "Ready", then click 2. Keys: G gestures, R reset, +/- zoom. Node.js required.</p>
</div>
</body>
</html>
